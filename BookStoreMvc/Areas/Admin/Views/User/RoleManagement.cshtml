@model RoleManagementVM

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="py-2 text-white">Manage User Role</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row" id="manageUserForm">
            <div class="border p-3">
                <input asp-for="ApplicationUser.Id" hidden />
                <div class="form-floating py-2 col-12">
                    <input asp-for="ApplicationUser.Name" readonly class="form-control border-0 shadow" />
                    <label asp-for="ApplicationUser.Name" class="ms-2">User Name</label>
                </div>
                <div class="form-floating py-2 col-12">
                    <select asp-for="ApplicationUser.Role" asp-items="@Model.RoleList" class="form-select" id="UserRole"></select>
                    <label asp-for="ApplicationUser.Role" class="ms-2 text-muted">Role</label>
                </div>
                <div class="form-floating py-2 col-12">
                    <select asp-for="ApplicationUser.CompanyId" asp-items="@Model.CompanyList" class="form-select" id="UserCompany"></select>
                </div>
                <div class="row pt-2">
                    <div class="col-6 col-md-3">
                        <button id="roleSubmit" type="submit" class="btn btn-primary form-control">Update Role</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="User" asp-action="Index" class="btn btn-outline-primary border form-control">Back</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function toggleCompanyVisibility() {
                var selection = $('#UserRole option:selected').text();
                if (selection === 'Company') {
                    $('#UserCompany').show();
                } else {
                    $('#UserCompany').hide();
                }
            }

            // Run on page load
            toggleCompanyVisibility();

            // Also run when user changes the role
            $('#UserRole').change(toggleCompanyVisibility);
        });
    </script>
}
